# ==============================================================================
# MSBI SPINE-BRAIN BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to .env and replace placeholder values with environment secrets.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Server & Network Configuration
PORT=8000
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# Primary Database Connection
# Example: mysql://dbuser:dbpassword@dbhost:3306/dbname
DATABASE_URL=

# Core Authentication & Security
# Cryptographically random secret string (min 32 chars) for signing JWTs
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
SESSION_EXPIRES_IN_DAYS=7

# AES-256-GCM Key (exact 32 bytes / 64 hex characters) for database credential encryption
INTEGRATION_ENCRYPTION_KEY=

# Inbound Webhook Secrets (Fail-Closed)
WORDPRESS_FORM_WEBHOOK_SECRET=
GOOGLE_REVIEWS_WEBHOOK_SECRET=

# Google OAuth & Marketing Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/oauth/callback
GOOGLE_GA4_PROPERTY_ID=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Google Pub/Sub & GCP
PUBSUB_TOPIC=
PUBSUB_SUBSCRIPTION=

# Meta Marketing API
META_GRAPH_API_VERSION=v26.0

# CallRail Call Tracking
CALLRAIL_API_TOKEN=

# Notification & Alerting Services
SENDGRID_API_KEY=
EMAIL_FROM=alerts@msbi-spine-brain.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
